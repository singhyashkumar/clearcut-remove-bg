// Staging configuration for the Clearcutt Worker (Workstream 3).
//
// This file is completely separate from the production "wrangler.jsonc":
// different Worker name, different D1 database, localhost-only origins and
// Razorpay test mode. It must never be pointed at production resources.
//
// Secrets (Razorpay TEST-mode keys and SECURITY_ADMIN_UIDS) are deliberately
// NOT declared here — set them per environment with
//   npx wrangler secret put <NAME> --config wrangler.staging.jsonc
// Never commit keys, secrets or Firebase UIDs, and never copy production
// credentials into staging.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clearcut-payments-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "triggers": { "crons": ["15 3 * * *"] },
  "vars": {
    "FIREBASE_PROJECT_ID": "clearcut-remove-bg",
    "PAYMENT_MODE": "test",
    "PLAN_AMOUNT_PAISE": "9000",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clearcut-payments-staging",
      "database_id": "160e532c-3c46-4193-a9e3-84f80a5db239",
      "migrations_dir": "worker/migrations"
    }
  ]
}
